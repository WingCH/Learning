# 可選設定；沒有設定時會使用括號內的值。
BOT_NAME=Personal WhatsApp Bot
WHATSAPP_AUTH_DIR=.data/whatsapp-auth
WHATSAPP_QR_OUTPUT_PATH=.data/latest-whatsapp-qr.txt
OPENROUTER_API_KEY=
OPENROUTER_MODEL=@preset/whatsapp-auto-reply
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_REQUEST_TIMEOUT_MS=30000
# 選填：OpenRouter attribution 用的網站 URL。
OPENROUTER_HTTP_REFERER=
CONVERSATION_MEMORY_PATH=.data/conversation-memory.json
CONVERSATION_HISTORY_MAX_CHATS=100
CONVERSATION_COMPACTION_TRIGGER_TURNS=20
CONVERSATION_COMPACTION_TRIGGER_CHARACTERS=12000
CONVERSATION_COMPACTION_KEEP_RECENT_TURNS=8
CONVERSATION_MAX_SUMMARY_CHARACTERS=4000
CONVERSATION_HARD_MAX_TURNS_PER_CHAT=40
CONVERSATION_HARD_MAX_CHARACTERS_PER_CHAT=24000
OPENROUTER_SUMMARY_MODEL=@preset/whatsapp-auto-reply
AI_RESPONSE_DELAY_MIN_MS=2000
AI_RESPONSE_DELAY_MAX_MS=5000
LOG_LEVEL=info
REPLY_TO_GROUPS=false
MAX_RECONNECT_ATTEMPTS=8
RECONNECT_BASE_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000
MAX_MESSAGE_STORE_ENTRIES=1000
